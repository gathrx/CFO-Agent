GOOGLE_API_KEY=your-gemini-api-key-here
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
MONTHLY_INVESTMENT_GOAL_PCT=30.0
NIGHTLY_ALERT_HOUR=21
CORS_ORIGINS=http://localhost:3000,https://your-app.web.app

# Comma-separated Google accounts allowed to use the API
ALLOWED_EMAILS=you@gmail.com
# Firebase project for sign-in (defaults to GCP_PROJECT_ID)
FIREBASE_PROJECT_ID=
# Cloud Run URL, only needed if Cloud Scheduler calls the API with an OIDC token
API_AUDIENCE=
# Local development only
AUTH_DISABLED=false
